── Expert FFN (per expert, shared across all loops) ──
input_dim = 100 # full 10×10 patch (includes overlap)
d_hidden = 256 # expansion within subspace
output_dim = 100 # writes back to full 10×10 patch
gate_proj = [100 × 256] # 25,600 params
up_proj = [100 × 256] # 25,600 params
